([i:i],v):v=@(b,!buffer(#b,0),0;c<#a;a,b[c:^a(a[c])],c+1;b)
([i:b],v):v=@(b,!buffer(0,0),0;c<#a;a,^a(a[c])?!concat(b,!buffer(1,a[c])):b,c+1;b)
([i,i:i],v,i)=@(b,c,0;c<#a;a,^a(b,a[c]),c+1;b)
(v,i):v=!concat(a,!buffer(1,b))
(v,i,i):v=right=a[c];left=a[b];a[b:right][c:left]
(v):v=!slice(a,0,#a-1)
(v)=@(a,a[0],1;c<#a;a,a[c]<b?a[c]:b,c+1;b)
(v)=@(a,a[0],1;c<#a;a,a[c]>b?a[c]:b,c+1;b)
(v)=@(a,0,0;c<#a;a,b+a[c],c+1;b)
